# ==========================================================
# AI Human-in-the-Loop Queue Configuration
# ==========================================================

# 1. PostgreSQL Database Configuration
# Format: postgresql+psycopg2://<user>:<password>@<host>:<port>/<dbname>
# Default local SQLite is used if PostgreSQL URL is commented out.
DATABASE_URL=sqlite:///./queue_app.db
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/queue_db

# 2. Telegram Bot & Mini App Configuration
# Token from @BotFather
TELEGRAM_BOT_TOKEN=
# Public HTTPS URL of the Mini App (e.g. ngrok / cloudflare tunnel / domain)
TELEGRAM_WEBAPP_URL=http://localhost:8000
# Admin chat ID or user ID for instant push notifications
TELEGRAM_ADMIN_CHAT_ID=

# 3. Queue Server Configuration
PORT=8000
HOST=0.0.0.0
WORKER_INTERVAL_SECONDS=60
